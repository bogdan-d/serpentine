// Allow CoreCtrl to execute privileged operations without password prompt
// This rule allows users in the "wheel" group to run CoreCtrl helper services
polkit.addRule(function(action, subject) {
    if ((action.id == "org.corectrl.helper.init" ||
         action.id == "org.corectrl.helperkiller.init") &&
        subject.local == true &&
        subject.active == true &&
        subject.isInGroup("wheel")) {
            return polkit.Result.YES;
    }
});
